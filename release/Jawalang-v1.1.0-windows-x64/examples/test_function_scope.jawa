// GLOBAL LOOKUP

gawe globalNama = "Global"

guna bacaGlobal() {
    tulis globalNama
}

bacaGlobal()


// LOCAL SHADOWING

gawe nama = "Global"

guna shadow() {
    gawe nama = "Local"
    tulis nama
}

shadow()

tulis nama


// PARAMETER SCOPE

gawe angka = 100

guna parameterTest(angka) {
    tulis angka
}

parameterTest(20)

tulis angka


// GLOBAL ASSIGNMENT

gawe counter = 0

guna tambahCounter() {
    counter = counter + 1
}

tambahCounter()
tambahCounter()

tulis counter


// LOCAL ASSIGNMENT

gawe nilai = 10

guna localTest() {
    gawe nilai = 100
    nilai = nilai + 1
    tulis nilai
}

localTest()

tulis nilai


// RECURSIVE SCOPE

guna hitung(n) {

    gawe lokal = n

    yen n <= 0 {
        bali
    }

    tulis lokal

    hitung(n - 1)
}

hitung(3)
