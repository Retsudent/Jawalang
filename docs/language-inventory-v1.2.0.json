{
  "version": "1.2.0",
  "language": "Jawalang",
  "extension": ".jawa",
  "keywords": [
    "tulis",
    "gawe",
    "yen",
    "liyane",
    "nalika",
    "kanggo",
    "nganti",
    "langkah",
    "saben",
    "ing",
    "mandheg",
    "lanjut",
    "guna",
    "bali",
    "bener",
    "salah",
    "null",
    "coba",
    "tangkep",
    "lempar",
    "impor",
    "ekspor",
    "saka",
    "minangka",
    "bentuk",
    "wiwiti",
    "anyar",
    "iki",
    "ngembangake",
    "super",
    "lan",
    "utawa",
    "ora"
  ],
  "builtins": {
    "jinis": { "parameters": ["nilai"], "returnType": "string", "description": "Deteksi tipe data nilai" },
    "dawa": { "parameters": ["koleksi"], "returnType": "number", "description": "Dawane array utawa cacahe karakter ing string" },
    "jupuk": { "parameters": ["array", "indeks"], "returnType": "any", "description": "Njupuk elemen array ing indeks tartamtu" },
    "nambah": { "parameters": ["array", "elemen"], "returnType": "null", "description": "Nambah elemen anyar ing mburi array" },
    "busak": { "parameters": ["array", "indeks"], "returnType": "null", "description": "Mbusak elemen ing indeks tartamtu saka array" },
    "motong": { "parameters": ["string", "mulai", "akhir"], "returnType": "string", "description": "Motong bagean string adhedhasar indeks" },
    "ngganti": { "parameters": ["string", "lama", "anyar"], "returnType": "string", "description": "Ngganti substring nganggo teks pangganti" },
    "gedhe": { "parameters": ["string"], "returnType": "string", "description": "Ngowahi huruf dadi kapital" },
    "cilik": { "parameters": ["string"], "returnType": "string", "description": "Ngowahi huruf dadi cilik" },
    "takon": { "parameters": ["prompt?"], "returnType": "string", "description": "Nampa input teks interaktif saka stdin" },
    "kunci": { "parameters": ["obyek"], "returnType": "array", "description": "Mbalekake array kunci obyek" },
    "nilai": { "parameters": ["obyek"], "returnType": "array", "description": "Mbalekake array nilai obyek" },
    "duwe": { "parameters": ["obyek", "kunci"], "returnType": "boolean", "description": "Priksa apa kunci ana ing obyek" },
    "terapkan": { "parameters": ["fn", "array"], "returnType": "array", "description": "HOF map" },
    "saring": { "parameters": ["predikat", "array"], "returnType": "array", "description": "HOF filter" },
    "itung": { "parameters": ["predikat", "array"], "returnType": "number", "description": "HOF count" },
    "ana": { "parameters": ["predikat", "array"], "returnType": "boolean", "description": "HOF some" },
    "kabeh": { "parameters": ["predikat", "array"], "returnType": "boolean", "description": "HOF every" },
    "golek": { "parameters": ["predikat", "array"], "returnType": "any", "description": "HOF find" },
    "indeks": { "parameters": ["predikat", "array"], "returnType": "number", "description": "HOF findIndex" },
    "gabung": { "parameters": ["array", "pamisah"], "returnType": "string", "description": "Nggabungake elemen array dadi string" },
    "balik": { "parameters": ["array"], "returnType": "array", "description": "Mbalekake array kewalik" },
    "urut": { "parameters": ["array", "komparator?"], "returnType": "array", "description": "Mbalekake array diurutake" }
  },
  "repl": {
    "prompts": {
      "primary": "jawa> ",
      "multiline": "...> "
    },
    "banner": "Jawalang REPL v1.2.0\nKetik .bantu untuk bantuan.\n",
    "commands": {
      ".help": "Show help",
      ".bantu": "Tampilake pitulung",
      ".exit": "Exit REPL",
      ".metu": "Metu saka REPL",
      ".clear": "Clear screen",
      ".resik": "Resiki layar"
    }
  }
}
